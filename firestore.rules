rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Global Safety Net (Default Deny)
    match /{document=**} {
      allow read, write: if false;
    }

    // Global Hardened Primitives
    function isSignedIn() {
      return request.auth != null && request.auth.token.email_verified == true;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    // Validation Blueprint: UserProfile
    function isValidUserProfile(data, userId) {
      return data.keys().hasAll(['uid', 'displayName', 'preferredLanguage', 'voiceEnabled', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly(['uid', 'displayName', 'preferredLanguage', 'voiceEnabled', 'createdAt', 'updatedAt'])
        && data.uid is string
        && data.uid.size() <= 128
        && data.uid.matches('^[a-zA-Z0-9_\\-]+$')
        && data.uid == request.auth.uid
        && data.uid == userId
        && data.displayName is string
        && data.displayName.size() <= 120
        && data.preferredLanguage is string
        && data.preferredLanguage.size() >= 1
        && data.preferredLanguage.size() <= 60
        && data.voiceEnabled is bool
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    // Validation Blueprint: RobotMemory
    function isValidRobotMemory(data) {
      return data.keys().hasAll(['ownerId', 'key', 'value', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly(['ownerId', 'key', 'value', 'createdAt', 'updatedAt'])
        && data.ownerId is string
        && data.ownerId.size() <= 128
        && data.ownerId.matches('^[a-zA-Z0-9_\\-]+$')
        && data.ownerId == request.auth.uid
        && data.key is string
        && data.key.size() >= 1
        && data.key.size() <= 80
        && data.value is string
        && data.value.size() >= 1
        && data.value.size() <= 400
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    // Validation Blueprint: RobotHighlight
    function isValidRobotHighlight(data) {
      return data.keys().hasAll(['ownerId', 'speaker', 'text', 'emotion', 'createdAt'])
        && data.keys().hasOnly(['ownerId', 'speaker', 'text', 'emotion', 'createdAt'])
        && data.ownerId is string
        && data.ownerId.size() <= 128
        && data.ownerId.matches('^[a-zA-Z0-9_\\-]+$')
        && data.ownerId == request.auth.uid
        && data.speaker is string
        && data.speaker.size() <= 16
        && data.speaker in ['user', 'moxi']
        && data.text is string
        && data.text.size() >= 1
        && data.text.size() <= 600
        && data.emotion is string
        && data.emotion.size() >= 1
        && data.emotion.size() <= 32
        && data.createdAt is timestamp;
    }

    function parentUserExists(userId) {
      return exists(/databases/$(database)/documents/users/$(userId));
    }

    // User Profile Collection
    match /users/{userId} {
      allow get: if isValidId(userId) && isOwner(userId);
      allow list: if false;

      allow create: if isValidId(userId)
        && isOwner(userId)
        && isValidUserProfile(incoming(), userId)
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;

      allow update: if isValidId(userId)
        && isOwner(userId)
        && isValidUserProfile(incoming(), userId)
        && incoming().uid == existing().uid
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && incoming().diff(existing()).affectedKeys().hasOnly(['displayName', 'preferredLanguage', 'voiceEnabled', 'updatedAt']);

      allow delete: if false;

      // Subcollection: MOXI Memories
      match /memories/{memoryId} {
        allow get: if isValidId(userId)
          && isValidId(memoryId)
          && isOwner(userId)
          && existing().ownerId == request.auth.uid;

        allow list: if isOwner(userId)
          && resource.data.ownerId == request.auth.uid;

        allow create: if isValidId(userId)
          && isValidId(memoryId)
          && isOwner(userId)
          && isValidRobotMemory(incoming())
          && incoming().ownerId == userId
          && incoming().createdAt == request.time
          && incoming().updatedAt == request.time
          && parentUserExists(userId);

        allow update: if isValidId(userId)
          && isValidId(memoryId)
          && isOwner(userId)
          && isValidRobotMemory(incoming())
          && incoming().ownerId == existing().ownerId
          && incoming().createdAt == existing().createdAt
          && incoming().updatedAt == request.time
          && incoming().diff(existing()).affectedKeys().hasOnly(['key', 'value', 'updatedAt'])
          && parentUserExists(userId);

        allow delete: if isValidId(userId)
          && isValidId(memoryId)
          && isOwner(userId)
          && existing().ownerId == request.auth.uid;
      }

      // Subcollection: MOXI Conversation Highlights
      match /highlights/{highlightId} {
        allow get: if isValidId(userId)
          && isValidId(highlightId)
          && isOwner(userId)
          && existing().ownerId == request.auth.uid;

        allow list: if isOwner(userId)
          && resource.data.ownerId == request.auth.uid;

        allow create: if isValidId(userId)
          && isValidId(highlightId)
          && isOwner(userId)
          && isValidRobotHighlight(incoming())
          && incoming().ownerId == userId
          && incoming().createdAt == request.time
          && parentUserExists(userId);

        allow update: if false;

        allow delete: if isValidId(userId)
          && isValidId(highlightId)
          && isOwner(userId)
          && existing().ownerId == request.auth.uid;
      }
    }
  }
}
